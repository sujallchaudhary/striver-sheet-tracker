# Editor/IDE configs
.claude/

# Dependencies
node_modules/

# Runtime data — the SQLite database with every account's progress,
# API keys and Notion tokens. Created on first run; never commit it.
data/

# Environment variables (API keys for docker-compose)
.env

# Logs
*.log
npm-debug.log*

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Local scratch scripts stay out of the repo, but the migration helper is
# part of the app and is copied into the Docker image.
# Note: this must exclude the directory's *contents*, not the directory
# itself — git cannot re-include a file whose parent directory is excluded.
scripts/*
!scripts/import-legacy-db.js
