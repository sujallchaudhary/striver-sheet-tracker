# Copy this to .env and fill in your values.
# Never commit .env to git.

# --- Google sign-in (required) ---
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   http://localhost:3210/auth/google/callback     (local)
#   https://your-domain.com/auth/google/callback   (deployed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of this instance. Only needed when the app cannot work it out
# itself (e.g. behind a proxy that rewrites Host). Used to build the OAuth
# redirect URI, so it must match what you registered with Google.
# APP_URL=https://your-domain.com

# --- Storage ---
# Where dsa.db lives. Defaults to ./data
# DSA_DATA_DIR=/data

# NOTE: AI / Notion / YouTube keys are no longer read from the environment.
# Each account stores its own keys in Settings, so users on a shared instance
# never spend the host's API credit.
